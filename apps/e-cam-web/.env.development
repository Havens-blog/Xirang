# 开发环境配置

# 应用标题
VITE_APP_TITLE=多云资产管理系统 - 开发环境

# API基础URL (开发环境使用代理)
VITE_API_BASE_URL=/api/v1

# 后端服务地址
VITE_BACKEND_URL=http://localhost:8001

# 是否启用Mock数据
VITE_USE_MOCK=false

# 开发服务器端口
VITE_PORT=5173

# 登录失效时跳转的 ecmdb-web 登录入口（经 nginx :8888）。
# e-cam-web 自身无登录页，ecmdb-token-key cookie 由 ecmdb-web 在 :8888 写入。
# 直接访问 :5173 会绕过 nginx，导致无共享 cookie 与 /api/iam 错路由，故始终应经 :8888 访问。
VITE_ECMDB_LOGIN_URL=http://localhost:8888
